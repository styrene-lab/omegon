/// Omegon profile schema.
///
/// The profile is the persistent user configuration that survives across
/// sessions. Stored as JSON at `~/.omegon/profile.json` (global) or
/// `.omegon/profile.json` (project-level).
///
/// This maintained schema describes editor-facing profile vocabulary. The Rust
/// profile parser remains runtime authority and validates against the active
/// product component catalog.
module Profile

/// Model reference — provider:modelId pair.
class ModelRef {
  provider: String(length > 0)
  modelId: String(length > 0)
}

/// Stable, human-readable profile identifier for compact UI surfaces.
name: String(length > 0)?

/// Optional longer display label for settings and help surfaces.
displayName: String(length > 0)?

/// Last used model selection.
lastUsedModel: ModelRef?

/// Thinking level for reasoning-capable models.
thinkingLevel: ("off"|"minimal"|"low"|"medium"|"high"|"xhigh"|"max")?

/// Maximum agent turns per invocation.
maxTurns: Int(this > 0)?

/// Provider preference order. First = most preferred.
providerOrder: Listing<String>?

/// Explicit fallback providers for interactive routing. Empty/missing means
/// fail explicitly when selected-provider credentials are unavailable.
fallbackProviders: Listing<String>?

/// Default behavioral posture.
defaultPosture: ("explorator"|"fabricator"|"architect"|"devastator")?

class Permissions {
  /// Stable dynamic contribution IDs explicitly trusted to execute with host authority.
  /// Forms include extension:<manifest-name>, plugin:<directory-name>, mcp:project,
  /// and mcp:acp-client. This is separate from trustedDirectories and does not
  /// grant tool capabilities or verified confinement. The identity grant persists
  /// across source updates; each runtime permit is separately source-digest-bound.
  trustedContributionCode: Listing<String>?

  /// Directories outside the workspace the agent can access without
  /// per-operation confirmation. Paths are expanded at runtime (~ → $HOME).
  trustedDirectories: Listing<String>?
}

/// Activation request for a release-coupled core product component.
class ComponentSwitch {
  enabled: Boolean
}

/// Stable selectors currently accepted by the maintained profile schema.
components: Mapping<("core:codescan"|"core:*"), ComponentSwitch>?

/// Unified operator permission policy.
permissions: Permissions?

/// Legacy compatibility alias for permissions.trustedDirectories.
trustedDirectories: Listing<String>?

/// Update channel for self-update.
updateChannel: ("stable"|"nightly")?

/// Auto-update on session exit when a newer version is available.
autoUpdate: Boolean?

/// Tool output density.
toolDetail: ("lean"|"compact"|"detailed"|"verbose")?

/// Mouse interaction mode. false = terminal-native text selection.
mouse: Boolean?

/// Per-editor executable overrides. Keys are stable integration IDs such as
/// `zed` and `vscode`; values may be absolute paths or command names resolved
/// through `PATH`. Values are executed directly, never through a shell.
editorCommands: Mapping<String, String>?

/// Active persona to restore on session start.
persona: String?

/// Active tone to restore on session start.
tone: String?

/// Optional interactive base. Missing preserves the entry default: om inline, omegon fullscreen.
uiTerminal: ("inline"|"fullscreen")?

/// Detail independent of terminal layout. Legacy om/lean/slim resolve to active.
uiPresentation: ("active"|"full"|"om"|"lean"|"slim")?
