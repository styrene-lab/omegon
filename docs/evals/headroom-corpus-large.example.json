{
  "version": 1,
  "description": "Optional broad local corpus for native headroom dogfooding. The collector clones public repositories and copies bounded samples under .tmp/headroom/; no corpus data should be committed.",
  "repos": [
    {
      "name": "tokio",
      "url": "https://github.com/tokio-rs/tokio.git",
      "ref": "master",
      "files": [
        {
          "name": "tokio-lib-rs",
          "path": "tokio/src/lib.rs",
          "kind_hint": "code",
          "min_savings_percent": 25,
          "expected_compressed": true,
          "max_output_bytes": 500000
        },
        {
          "name": "tokio-readme",
          "path": "README.md",
          "kind_hint": "markdown",
          "min_savings_percent": 25,
          "expected_compressed": true,
          "max_output_bytes": 500000
        }
      ],
      "commands": [
        {
          "name": "tokio-recent-log",
          "command": ["git", "log", "--oneline", "-n", "200"],
          "kind_hint": "plain_text",
          "min_savings_percent": 20,
          "expected_compressed": true,
          "max_output_bytes": 500000
        },
        {
          "name": "tokio-grep-tests",
          "command": ["git", "grep", "-n", "#\\[tokio::test\\]"],
          "kind_hint": "plain_text",
          "min_savings_percent": 20,
          "expected_compressed": true,
          "max_output_bytes": 500000
        }
      ]
    },
