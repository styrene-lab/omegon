{
  "name": "omegon-site-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/load-snippets.mjs && node scripts/fetch-releases.mjs && node scripts/collect-stats.mjs && node scripts/build-design-tree.mjs && astro build",
    "test": "node --test tests/docs-content.test.mjs",
    "preview": "astro preview",
    "diagrams:dev": "likec4 dev diagrams/likec4 --listen 127.0.0.1 --port 5173",
    "diagrams:build": "likec4 build diagrams/likec4 --output dist/likec4",
    "diagrams:validate": "likec4 validate diagrams/likec4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^7.0.7",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "likec4": "1.59.4"
  }
}
